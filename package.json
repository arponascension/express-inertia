{
  "name": "@arponascension/express-inertia",
  "version": "1.5.0",
  "description": "Inertia.js adapter and middleware for Express.js (Node.js). Build modern single-page applications (SPA) with Vue 3, React, or Svelte using classic server-side routing — Blade-style EJS templates, Vite integration (HMR + manifest.json), server-side rendering (SSR), and TypeScript.",
  "homepage": "https://github.com/arponascension/express-inertia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arponascension/express-inertia.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.mjs",
      "require": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "inertia",
    "inertiajs",
    "express-inertia",
    "middleware",
    "express-middleware",
    "blade",
    "ejs",
    "vite",
    "vite-plugin",
    "ssr",
    "server-side-rendering",
    "vue",
    "react",
    "svelte",
    "spa",
    "single-page-application",
    "node",
    "nodejs",
    "typescript",
    "hmr"
  ],
  "author": "Arpon",
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^2.2.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "express": "^4.21.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13"
  }
}
