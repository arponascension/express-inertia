{
  "name": "@arponascension/express-inertia",
  "version": "1.0.1",
  "description": "Next-generation Inertia.js adapter and middleware for Express with Blade-style EJS components, Vite integration, and SSR support",
  "homepage": "https://github.com/arponascension/express-inertia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arponascension/express-inertia.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.mjs",
      "require": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "inertia",
    "inertiajs",
    "middleware",
    "blade",
    "ejs",
    "vite",
    "ssr",
    "vue",
    "react",
    "svelte"
  ],
  "author": "Arpon",
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@inertiajs/vue3": "^2.2.12",
    "@vitejs/plugin-vue": "^5.2.3",
    "express": "^4.21.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13"
  }
}
